---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found | Muzicks" description="The page you were looking for could not be found." noindex>
  <section class="bg-midnight text-ivory">
    <div class="wrap py-28 sm:py-36">
      <p class="kicker text-brass">A missed note</p>
      <h1 class="display-xl mt-3 max-w-3xl">This page isn’t here.</h1>
      <p class="lead mt-6 max-w-xl text-ivory/80">It may have moved when our website was rebuilt. Try one of these instead:</p>
      <ul class="mt-10 flex flex-wrap gap-3">
        <li><a href="/" class="btn btn-brass">Home</a></li>
        <li><a href="/courses/" class="btn btn-outline-light">Courses</a></li>
        <li><a href="/concerts/" class="btn btn-outline-light">Concerts</a></li>
        <li><a href="/contact/" class="btn btn-outline-light">Contact</a></li>
      </ul>
    </div>
  </section>
</BaseLayout>
