---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CourseGrid from '../../components/CourseGrid.astro';
import { COURSES } from '../../data/courses';
import { breadcrumbSchema } from '../../lib/schema';
import { SITE } from '../../config/site.config';

const crumbs = [{ name: 'Home', href: '/' }, { name: 'Courses', href: '/courses/' }];
const itemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: COURSES.map((c, i) => ({ '@type': 'ListItem', position: i + 1, url: `${SITE.url}/courses/${c.slug}/`, name: c.name })),
};
---

<BaseLayout
  title="Music Courses in Kolkata & Online | Muzicks"
  description="All Muzicks courses: guitar, keyboard, ukulele, flute, harmonica, violin, Western vocals, Hindustani classical and Bollywood singing — in Kolkata and online."
  schema={[breadcrumbSchema(crumbs), itemList]}
  whatsappKind="course"
>
  <section class="bg-midnight text-ivory">
    <div class="wrap pb-16 pt-8 sm:pt-10 lg:pb-20">
      <Breadcrumbs items={crumbs} light />
      <h1 class="display-lg mt-10 max-w-4xl">Music courses for every kind of musician</h1>
      <p class="lead mt-6 max-w-2xl text-ivory/80">
        Choose an instrument or a vocal style. Every course is available for children and adults, with lessons in Kolkata and online.
      </p>
    </div>
  </section>

  <section class="wrap py-16 sm:py-24">
    <CourseGrid />
  </section>

  <section class="bg-sand py-16 sm:py-20">
    <div class="wrap flex flex-col justify-between gap-6 md:flex-row md:items-center">
      <div>
        <h2 class="display-md">Not sure where to start?</h2>
        <p class="mt-3 max-w-xl text-stone">Tell us about the learner and we will suggest the right course and level.</p>
      </div>
      <a href="/contact/?type=course" class="btn btn-dark">Ask for a recommendation</a>
    </div>
  </section>
</BaseLayout>
