---
import type { ImageKey } from '../config/images';
import { resolveImage, imageUrl, imageSrcset } from '../lib/images';

export interface Props {
  image: ImageKey | string;
  alt?: string;
  /** width / height, e.g. 4/5. Sets crop and reserves space (no layout shift). */
  ratio?: number;
  sizes?: string;
  widths?: number[];
  eager?: boolean;
  class?: string;
}

const { image, alt, ratio = 4 / 3, sizes = '(min-width: 1024px) 50vw, 100vw', widths = [480, 800, 1200, 1600], eager = false, class: cls = '' } = Astro.props;
const img = resolveImage(image, alt);
const base = widths[1] ?? widths[0];
---
<img
  src={imageUrl(img.src, base, Math.round(base / ratio))}
  srcset={imageSrcset(img.src, widths, ratio)}
  sizes={sizes}
  alt={alt ?? img.alt}
  width={base}
  height={Math.round(base / ratio)}
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : 'auto'}
  decoding="async"
  class={`object-cover ${cls}`}
  style={`aspect-ratio:${ratio}`}
/>
