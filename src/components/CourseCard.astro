---
import Img from './Img.astro';
import type { Course } from '../data/courses';

export interface Props { course: Course; dark?: boolean }
const { course, dark = false } = Astro.props;
---
<a href={`/courses/${course.slug}/`} class="group block" data-category={course.category}>
  <div class="overflow-hidden rounded-2xl bg-sand">
    <Img
      image={course.image}
      ratio={4 / 5}
      widths={[360, 560, 800]}
      sizes="(min-width: 1024px) 28vw, (min-width: 640px) 45vw, 90vw"
      class="h-full w-full transition-transform duration-700 group-hover:scale-[1.04]"
    />
  </div>
  <div class="mt-4 flex items-baseline justify-between gap-3">
    <h3 class="text-[1.9rem]">{course.name}</h3>
    <span class={`text-sm ${dark ? 'text-mist' : 'text-stone'}`}>{course.category === 'vocal' ? 'Vocal' : 'Instrument'}</span>
  </div>
  <p class={`mt-1 ${dark ? 'text-mist' : 'text-stone'}`}>{course.cardBlurb}</p>
</a>
