---
import { ChevronDown, Menu, X, Phone } from 'lucide-react';
import Logo from './Logo.astro';
import WhatsAppIcon from './WhatsAppIcon.astro';
import { INSTRUMENTAL, VOCAL } from '../data/courses';
import { CONTACT, OFFERS_DEMO_CLASS } from '../config/site.config';
import { whatsappLink } from '../lib/whatsapp';

const path = Astro.url.pathname;
const isActive = (href: string) => path.startsWith(href);
const academyActive = isActive('/academy/') || isActive('/courses/');
const wa = whatsappLink('general');

/** The three business verticals lead the navigation, each with its own accent. */
const verticals = [
  { label: 'Concerts', href: '/concerts/', accent: 'bg-ember' },
  { label: 'Studio', href: '/studio/', accent: 'bg-teal' },
];
const secondary = [
  { label: 'About', href: '/about/' },
  { label: 'Blog', href: '/blog/' },
  { label: 'Contact', href: '/contact/' },
];
---

<!-- Utility strip (scrolls away) -->
<div class="bg-midnight text-ivory/75">
  <div class="wrap flex h-8 items-center justify-end gap-4 text-[0.78rem] sm:justify-between">
    <p class="hidden truncate sm:block">Music academy in Kolkata <span class="text-ivory/40">&amp;</span> online</p>
    <ul class="flex shrink-0 items-center gap-5">
      {CONTACT.phone && (
        <li><a href={`tel:${CONTACT.phone}`} class="inline-flex items-center gap-1.5 hover:text-ivory"><Phone className="h-3 w-3" aria-hidden="true" />{CONTACT.phoneDisplay}</a></li>
      )}
      {wa && (
        <li><a href={wa} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 hover:text-ivory"><WhatsAppIcon class="h-3 w-3" />WhatsApp</a></li>
      )}
    </ul>
  </div>
</div>

<header id="site-header" class="sticky top-0 z-50 border-b border-line bg-ivory/95 text-midnight backdrop-blur-md transition-shadow data-[scrolled=true]:shadow-[0_8px_30px_-18px_rgba(21,26,35,0.45)]">
  <div class="wrap flex h-14 items-center justify-between gap-6 lg:h-16">
    <a href="/" aria-label="Muzicks — home" class="shrink-0"><Logo light={false} compact /></a>

    <nav aria-label="Main" class="hidden self-stretch lg:block">
      <ul class="flex h-full items-stretch gap-1">
        <!-- Academy with mega menu -->
        <li class="group static flex">
          <a
            href="/academy/"
            aria-current={academyActive ? 'page' : undefined}
            class="relative inline-flex items-center gap-1.5 px-4 text-[0.98rem] font-semibold"
          >
            <span class:list={['h-1.5 w-1.5 rounded-full bg-brass', academyActive ? 'opacity-100' : 'opacity-60']} aria-hidden="true"></span>
            Academy
            <ChevronDown className="h-4 w-4 opacity-60 transition-transform group-hover:rotate-180 group-focus-within:rotate-180" aria-hidden="true" />
            <span class:list={['absolute inset-x-4 -bottom-px h-0.5 bg-brass transition-opacity', academyActive ? 'opacity-100' : 'opacity-0']} aria-hidden="true"></span>
          </a>
          <div class="invisible absolute inset-x-0 top-full border-t border-line bg-ivory opacity-0 shadow-[0_30px_60px_-30px_rgba(21,26,35,0.35)] transition-[opacity,visibility] duration-200 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
            <div class="wrap grid grid-cols-[1fr_1fr_1.1fr] gap-12 py-9">
              <div>
                <p class="kicker text-brass-deep">Instrumental</p>
                <ul class="mt-3 grid grid-cols-2 gap-x-6">
                  {INSTRUMENTAL.map((c) => (
                    <li><a href={`/courses/${c.slug}/`} class="block py-1.5 text-[1.02rem] hover:text-brass-deep">{c.name}</a></li>
                  ))}
                </ul>
              </div>
              <div>
                <p class="kicker text-brass-deep">Vocal</p>
                <ul class="mt-3">
                  {VOCAL.map((c) => (
                    <li><a href={`/courses/${c.slug}/`} class="block py-1.5 text-[1.02rem] hover:text-brass-deep">{c.name}</a></li>
                  ))}
                </ul>
                <div class="mt-5 flex gap-5 text-[0.95rem]">
                  <a href="/academy/" class="link-underline font-semibold decoration-brass">About the Academy</a>
                  <a href="/courses/" class="link-underline font-semibold decoration-brass">All courses</a>
                </div>
              </div>
              <div class="rounded-2xl bg-midnight p-7 text-ivory">
                <p class="font-[family-name:var(--font-display)] text-3xl leading-tight">Not sure where to start?</p>
                <p class="mt-2 text-mist">Tell us about the learner and we will suggest the right course and level — for children and adults.</p>
                <a href="/contact/?type=course" class="btn btn-brass mt-5 !min-h-11">{OFFERS_DEMO_CLASS ? 'Book a demo class' : 'Ask for a recommendation'}</a>
              </div>
            </div>
          </div>
        </li>

        {verticals.map((v) => (
          <li class="flex">
            <a
              href={v.href}
              aria-current={isActive(v.href) ? 'page' : undefined}
              class="relative inline-flex items-center gap-1.5 px-4 text-[0.98rem] font-semibold"
            >
              <span class:list={['h-1.5 w-1.5 rounded-full', v.accent, isActive(v.href) ? 'opacity-100' : 'opacity-60']} aria-hidden="true"></span>
              {v.label}
              <span class:list={['absolute inset-x-4 -bottom-px h-0.5 transition-opacity', v.accent, isActive(v.href) ? 'opacity-100' : 'opacity-0']} aria-hidden="true"></span>
            </a>
          </li>
        ))}

        <li class="mx-3 my-auto h-5 w-px bg-line" aria-hidden="true"></li>

        {secondary.map((s) => (
          <li class="flex">
            <a
              href={s.href}
              aria-current={isActive(s.href) ? 'page' : undefined}
              class:list={['inline-flex items-center px-3 text-[0.95rem] transition-colors', isActive(s.href) ? 'text-midnight font-semibold' : 'text-stone hover:text-midnight']}
            >{s.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a href="/contact/" class="btn btn-dark hidden sm:inline-flex !min-h-10 !px-5 text-[0.92rem]">Enquire now</a>
      <button
        type="button"
        id="nav-toggle"
        class="inline-flex h-10 items-center gap-2 rounded-full px-4 text-[0.95rem] font-semibold ring-1 ring-inset ring-line hover:ring-midnight/40 lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        Menu
        <Menu className="h-5 w-5" aria-hidden="true" />
      </button>
    </div>
  </div>
</header>

<!-- Mobile menu: a full-viewport overlay that fits the screen (no scrolling) -->
<div
  id="mobile-nav"
  role="dialog"
  aria-modal="true"
  aria-label="Menu"
  class="fixed inset-0 z-[60] hidden h-[100dvh] flex-col bg-ivory text-midnight lg:!hidden"
>
  <div class="wrap flex h-14 shrink-0 items-center justify-between border-b border-line">
    <a href="/" aria-label="Muzicks — home"><Logo light={false} compact /></a>
    <button
      type="button"
      id="nav-close"
      class="inline-flex h-10 items-center gap-2 rounded-full px-4 text-[0.95rem] font-semibold ring-1 ring-inset ring-line"
    >
      Close
      <X className="h-5 w-5" aria-hidden="true" />
    </button>
  </div>

  <nav aria-label="Mobile" class="wrap flex min-h-0 flex-1 flex-col justify-between gap-[clamp(0.75rem,2.2dvh,1.5rem)] py-[clamp(0.75rem,2.5dvh,1.75rem)]">
    <div class="flex min-h-0 flex-col gap-[clamp(0.5rem,1.4dvh,0.75rem)]">
      <div class="rounded-2xl bg-sand px-5 py-[clamp(0.75rem,2dvh,1.25rem)]">
        <a href="/academy/" class="flex items-center gap-2 font-[family-name:var(--font-display)] text-[clamp(1.6rem,3.6dvh,2rem)] font-semibold leading-none">
          <span class="h-2 w-2 rounded-full bg-brass" aria-hidden="true"></span>Academy
        </a>
        <div class="mt-[clamp(0.5rem,1.4dvh,0.9rem)] grid grid-cols-2 gap-x-4 text-[clamp(0.88rem,1.9dvh,1rem)]">
          <div>
            <p class="text-[0.8rem] font-semibold text-brass-deep">Instrumental</p>
            <ul>{INSTRUMENTAL.map((c) => <li><a href={`/courses/${c.slug}/`} class="block py-[clamp(0.15rem,0.55dvh,0.35rem)]">{c.name}</a></li>)}</ul>
          </div>
          <div>
            <p class="text-[0.8rem] font-semibold text-brass-deep">Vocal</p>
            <ul>{VOCAL.map((c) => <li><a href={`/courses/${c.slug}/`} class="block py-[clamp(0.15rem,0.55dvh,0.35rem)] leading-snug">{c.name}</a></li>)}</ul>
            <a href="/courses/" class="mt-1 block py-[clamp(0.15rem,0.55dvh,0.35rem)] font-semibold underline decoration-brass underline-offset-4">All courses</a>
          </div>
        </div>
      </div>
      <div class="grid grid-cols-2 gap-[clamp(0.5rem,1.4dvh,0.75rem)]">
        {verticals.map((v) => (
          <a href={v.href} class="flex items-center gap-2 rounded-2xl px-5 py-[clamp(0.7rem,1.9dvh,1.1rem)] font-[family-name:var(--font-display)] text-[clamp(1.4rem,3dvh,1.75rem)] font-semibold leading-none ring-1 ring-inset ring-line">
            <span class:list={['h-2 w-2 rounded-full', v.accent]} aria-hidden="true"></span>{v.label}
          </a>
        ))}
      </div>
      <ul class="flex flex-wrap gap-x-6 gap-y-1 px-1 text-[clamp(1rem,2.1dvh,1.1rem)]">
        {secondary.map((s) => <li><a href={s.href} class="text-stone hover:text-midnight">{s.label}</a></li>)}
      </ul>
    </div>

    <div class="grid shrink-0 grid-cols-2 gap-3">
      <a href="/contact/" class="btn btn-dark !min-h-12 w-full">Enquire now</a>
      {wa ? (
        <a href={wa} target="_blank" rel="noopener" class="btn btn-outline-dark !min-h-12 w-full"><WhatsAppIcon /> WhatsApp</a>
      ) : CONTACT.phone && (
        <a href={`tel:${CONTACT.phone}`} class="btn btn-outline-dark !min-h-12 w-full">Call us</a>
      )}
    </div>
  </nav>
</div>

<script>
  const header = document.getElementById('site-header');
  const openBtn = document.getElementById('nav-toggle');
  const closeBtn = document.getElementById('nav-close');
  const overlay = document.getElementById('mobile-nav');

  // Soft shadow once the page has scrolled under the header
  if (header) {
    const onScroll = () => header.setAttribute('data-scrolled', String(window.scrollY > 32));
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  if (openBtn && closeBtn && overlay) {
    const set = (open: boolean) => {
      overlay.classList.toggle('hidden', !open);
      overlay.classList.toggle('flex', open);
      openBtn.setAttribute('aria-expanded', String(open));
      document.documentElement.style.overflow = open ? 'hidden' : '';
      (open ? closeBtn : openBtn).focus();
    };
    openBtn.addEventListener('click', () => set(true));
    closeBtn.addEventListener('click', () => set(false));
    overlay.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => set(false)));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !overlay.classList.contains('hidden')) set(false);
    });
    window.matchMedia('(min-width: 1024px)').addEventListener('change', (e) => e.matches && set(false));
  }
</script>
